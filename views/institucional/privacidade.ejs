<%-include('../cabecalho.ejs')%>

<section class="page-hero">
    <div class="container narrow">
        <h1>Política de privacidade</h1>
    </div>
</section>

<article class="secao container narrow conteudo-modulo">
    <% if (config?.privacidade) { %>
        <p><%= config.privacidade %></p>
    <% } else { %>
        <h2>Dados utilizados</h2>
        <p>O AcervoTCC trata dados de cadastro, autoria, orientação, progresso e participação necessários ao funcionamento acadêmico da plataforma.</p>

        <h2>Finalidade e acesso</h2>
        <p>Os trabalhos publicados são públicos. Dados de conta e informações internas de avaliação ficam restritos aos perfis autorizados.</p>

        <h2>Contato</h2>
        <p>
            Para dúvidas ou solicitações, escreva para
            <a href="mailto:<%= config?.contato || 'contato@escola.edu.br' %>"><%= config?.contato || 'contato@escola.edu.br' %></a>.
        </p>
    <% } %>
</article>

<%-include('../rodape.ejs')%>

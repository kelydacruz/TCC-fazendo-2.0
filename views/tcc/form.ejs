<%# Funcionalidade exclusiva do AcervoTCC: vínculo acadêmico, PDF e autorização de publicação. %>
<div class="form-grid">
    <label class="span-2">
        Título
        <input name="titulo" required maxlength="240" value="<%= tcc?.titulo || '' %>">
    </label>

    <label class="span-2">
        Resumo
        <textarea name="resumo" required rows="8" maxlength="6000"><%= tcc?.resumo || '' %></textarea>
    </label>

    <label>
        Autores <small>(separados por vírgula)</small>
        <input name="autores" required value="<%= tcc?.autores?.join(', ') || usuarioAtual.nome %>">
    </label>

    <label>
        Palavras-chave <small>(separadas por vírgula)</small>
        <input name="palavrasChave" value="<%= tcc?.palavrasChave?.join(', ') || '' %>">
    </label>

    <% if (vinculoAluno) { %>
        <div class="span-2 vinculo-academico">
            <i class="fa-solid fa-graduation-cap"></i>
            <div>
                <small>Vínculo acadêmico definido pela administração</small>
                <strong><%= cursos[0]?.nome %></strong>
                <span><%= turmas[0]?.nome %> · <%= turmas[0]?.ano %></span>
            </div>
        </div>
        <input type="hidden" name="curso" value="<%= cursos[0]?.id %>">
        <input type="hidden" name="turma" value="<%= turmas[0]?.id %>">
    <% } else { %>
        <label>
            Curso
            <select name="curso" required>
                <option value="">Selecione</option>
                <% cursos.forEach(item => { %>
                    <option value="<%= item.id %>" <%= String(tcc?.curso || '') === item.id ? 'selected' : '' %>><%= item.nome %></option>
                <% }) %>
            </select>
        </label>

        <label>
            Turma
            <select name="turma" required>
                <option value="">Selecione</option>
                <% turmas.forEach(item => { %>
                    <option value="<%= item.id %>" <%= String(tcc?.turma || '') === item.id ? 'selected' : '' %>><%= item.nome %> · <%= item.ano %></option>
                <% }) %>
            </select>
        </label>
    <% } %>

    <label>
        Professor orientador
        <select name="orientador" required>
            <option value="">Selecione</option>
            <% professores.forEach(item => { %>
                <option value="<%= item.id %>" <%= String(tcc?.orientador || '') === item.id ? 'selected' : '' %>><%= item.nome %></option>
            <% }) %>
        </select>
    </label>

    <label>
        Ano de conclusão
        <input
            type="number"
            name="ano"
            min="2000"
            max="2100"
            required
            value="<%= tcc?.ano || new Date().getFullYear() %>"
        >
    </label>

    <label class="span-2">
        Área ou tema
        <input name="area" required value="<%= tcc?.area || '' %>">
    </label>

    <label>
        Arquivo PDF <small>(máx. 10 MB)</small>
        <input type="file" name="pdf" accept="application/pdf" <%= tcc?.pdf?.nome ? '' : 'required' %>>
        <% if (tcc?.pdf?.nome) { %>
            <small>Atual: <%= tcc.pdf.nome %></small>
        <% } %>
    </label>

    <label>
        Imagem de capa <small>(opcional)</small>
        <input type="file" name="capa" accept="image/png,image/jpeg,image/webp">
    </label>

    <label class="span-2 opcao-check">
        <input type="checkbox" name="ocultarAutores" value="true" <%= tcc?.ocultarAutores ? 'checked' : '' %>>
        <span>Ocultar os nomes dos autores no catálogo público</span>
    </label>

    <label class="span-2 opcao-check termo-publicacao">
        <input
            type="checkbox"
            name="termoAutorizacao"
            value="true"
            <%= tcc?.termoAutorizacao?.aceito ? 'checked disabled' : '' %>
        >
        <span>
            <strong>Autorizo a publicação deste TCC no AcervoTCC</strong>
            <small>Declaro que a versão enviada é final e que possuo autorização dos demais autores para disponibilização pública.</small>
        </span>
    </label>
</div>

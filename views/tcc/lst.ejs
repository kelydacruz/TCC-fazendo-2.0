<%- include('../partials/header') %><section class="page-hero"><div class="container page-flex"><div><span class="eyebrow">Acompanhamento</span><h1>Meus TCCs</h1><p>Consulte o status e as observações de cada trabalho.</p></div><a class="btn btn-branco" href="/tcc/add"><i class="fa-solid fa-plus"></i> Novo TCC</a></div></section><section class="secao container"><div class="tabela-wrap"><table><thead><tr><th>Título</th><th>Curso</th><th>Status</th><th>Atualizado</th><th></th></tr></thead><tbody><% tccs.forEach(item=>{ %><tr><td><strong><%= item.titulo %></strong><small><%= item.alunoResponsavel?.nome %></small></td><td><%= item.curso?.sigla %></td><td><span class="status"><%= item.status %></span></td><td><%= new Date(item.updatedAt).toLocaleDateString('pt-BR') %></td><td><a class="btn btn-claro" href="/tcc/edt/<%= item.id %>">Abrir</a></td></tr><% }) %></tbody></table></div><% if(!tccs.length){ %><div class="vazio"><h2>Nenhum TCC por aqui</h2><a class="btn btn-primario" href="/tcc/add">Enviar o primeiro</a></div><% } %></section><%- include('../partials/footer') %>

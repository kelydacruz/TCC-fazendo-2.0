<%- include('../partials/header') %><section class="page-hero"><div class="container"><span class="status"><%= tcc.status %></span><h1>Gerenciar TCC</h1><p><%= tcc.titulo %></p></div></section><section class="secao container narrow"><% if(editavel){ %><form class="form-card" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><%- include('form') %><div class="form-acoes"><button class="btn btn-outline" name="acao" value="rascunho">Salvar alterações</button><button class="btn btn-primario" name="acao" value="enviar">Enviar para avaliação</button></div></form><% }else{ %><div class="aviso"><i class="fa-solid fa-lock"></i><div><h2>Edição bloqueada</h2><p>O trabalho está em <strong><%= tcc.status %></strong>. Aguarde a avaliação ou uma solicitação de correções.</p></div></div><% } %><section class="subsecao"><h2>Histórico</h2><div class="timeline"><% tcc.historico.slice().reverse().forEach(item=>{ %><article><span></span><div><strong><%= item.status %></strong><small><%= new Date(item.data).toLocaleString('pt-BR') %></small><p><%= item.observacao||'Sem observações.' %></p></div></article><% }) %></div></section><% if(['professor','administrador'].includes(usuarioAtual.perfil)){ %><form class="form-card" method="post" action="/tcc/revisar/<%= tcc.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Registrar avaliação</h2><label>Novo status<select name="status" required><option>Aguardando revisão</option><option>Correções solicitadas</option><option>Aprovado</option><% if(usuarioAtual.perfil==='administrador'){ %><option>Publicado</option><option>Arquivado</option><% } %></select></label><label>Observações<textarea name="observacao" rows="5" maxlength="2000"></textarea></label><button class="btn btn-primario">Salvar avaliação</button></form><% } %><% if(tcc.status==='Rascunho'||usuarioAtual.perfil==='administrador'){ %><form class="form-perigo" method="post" action="/tcc/del/<%= tcc.id %>" data-confirm="Excluir este TCC permanentemente?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-perigo">Excluir TCC</button></form><% } %></section><%- include('../partials/footer') %>

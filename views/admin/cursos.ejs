<%- include('../partials/header') %><section class="page-hero"><div class="container"><h1>Cursos e turmas</h1></div></section><section class="secao container admin-grid"><div><h2>Novo curso</h2><form class="form-card" method="post" action="/admin/cursos"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nome<input name="nome" required></label><label>Sigla<input name="sigla" required maxlength="10"></label><label>Descrição<textarea name="descricao"></textarea></label><button class="btn btn-primario">Adicionar</button></form><h2>Cursos cadastrados</h2><% cursos.forEach(item=>{ %><form class="linha-form" method="post" action="/admin/cursos/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="nome" value="<%= item.nome %>"><input name="sigla" value="<%= item.sigla %>"><input type="hidden" name="descricao" value="<%= item.descricao||'' %>"><select name="ativo"><option value="true" <%= item.ativo?'selected':'' %>>Ativo</option><option value="false" <%= !item.ativo?'selected':'' %>>Inativo</option></select><button class="btn btn-claro">Salvar</button></form><% }) %></div><div><h2>Nova turma</h2><form class="form-card" method="post" action="/admin/turmas"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nome<input name="nome" required></label><label>Curso<select name="curso"><% cursos.forEach(i=>{ %><option value="<%= i.id %>"><%= i.nome %></option><% }) %></select></label><label>Ano<input type="number" name="ano" value="<%= new Date().getFullYear() %>" required></label><button class="btn btn-primario">Adicionar</button></form><h2>Turmas cadastradas</h2><% turmas.forEach(item=>{ %><form class="linha-form" method="post" action="/admin/turmas/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="nome" value="<%= item.nome %>"><select name="curso"><% cursos.forEach(i=>{ %><option value="<%= i.id %>" <%= String(item.curso?._id)===i.id?'selected':'' %>><%= i.sigla %></option><% }) %></select><input type="number" name="ano" value="<%= item.ano %>"><select name="ativa"><option value="true" <%= item.ativa?'selected':'' %>>Ativa</option><option value="false" <%= !item.ativa?'selected':'' %>>Inativa</option></select><button class="btn btn-claro">Salvar</button></form><% }) %></div></section><%- include('../partials/footer') %>

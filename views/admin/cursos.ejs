<%- include('../partials/header') %>
<section class="page-hero admin-hero"><div class="container"><span class="eyebrow">Administração</span><h1>Cursos e turmas</h1><p>Organize os vínculos acadêmicos usados pelos alunos e pelos TCCs.</p></div></section>
<%- include('nav') %>
<section class="secao container"><div class="admin-duas-colunas"><div><div class="secao-titulo"><div><h2>Cursos</h2><p><%= cursos.length %> cadastrados</p></div><details class="admin-criar"><summary class="btn btn-primario"><i class="fa-solid fa-plus"></i> Novo curso</summary><form class="form-card" method="post" action="/admin/cursos"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nome<input name="nome" required></label><label>Sigla<input name="sigla" required maxlength="10"></label><label>Descrição<textarea name="descricao" rows="3"></textarea></label><button class="btn btn-primario">Adicionar curso</button></form></details></div><div class="admin-lista"><% cursos.forEach(item=>{ %><details class="admin-item"><summary><div><strong><%= item.nome %></strong><small><%= item.sigla %></small></div><div class="admin-item-meta"><span class="status <%= item.ativo?'disponivel':'' %>"><%= item.ativo?'Ativo':'Inativo' %></span><i class="fa-solid fa-chevron-down"></i></div></summary><div class="admin-item-conteudo"><form method="post" action="/admin/cursos/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nome<input name="nome" value="<%= item.nome %>" required></label><div class="form-grid"><label>Sigla<input name="sigla" value="<%= item.sigla %>" required></label><label>Status<select name="ativo"><option value="true" <%= item.ativo?'selected':'' %>>Ativo</option><option value="false" <%= !item.ativo?'selected':'' %>>Inativo</option></select></label></div><label>Descrição<textarea name="descricao" rows="3"><%= item.descricao||'' %></textarea></label><div class="form-acoes"><button class="btn btn-primario">Salvar</button></div></form><form class="admin-excluir" method="post" action="/admin/cursos/<%= item.id %>/excluir" data-confirm="Excluir este curso? Cursos com vínculos serão apenas desativados."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-texto-perigo"><i class="fa-regular fa-trash-can"></i> Excluir curso</button></form></div></details><% }) %></div></div><div><div class="secao-titulo"><div><h2>Turmas</h2><p><%= turmas.length %> cadastradas</p></div><details class="admin-criar"><summary class="btn btn-primario"><i class="fa-solid fa-plus"></i> Nova turma</summary><form class="form-card" method="post" action="/admin/turmas"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nome<input name="nome" required></label><label>Curso<select name="curso" required><% cursos.filter(i=>i.ativo).forEach(i=>{ %><option value="<%= i.id %>"><%= i.nome %></option><% }) %></select></label><label>Ano<input type="number" name="ano" value="<%= new Date().getFullYear() %>" min="2000" max="2100" required></label><button class="btn btn-primario">Adicionar turma</button></form></details></div><div class="admin-lista"><% turmas.forEach(item=>{ %><details class="admin-item"><summary><div><strong><%= item.nome %></strong><small><%= item.curso?.sigla %> · <%= item.ano %></small></div><div class="admin-item-meta"><span class="status <%= item.ativa?'disponivel':'' %>"><%= item.ativa?'Ativa':'Inativa' %></span><i class="fa-solid fa-chevron-down"></i></div></summary><div class="admin-item-conteudo"><form method="post" action="/admin/turmas/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nome<input name="nome" value="<%= item.nome %>" required></label><div class="form-grid"><label>Curso<select name="curso"><% cursos.forEach(i=>{ %><option value="<%= i.id %>" <%= String(item.curso?._id)===i.id?'selected':'' %>><%= i.sigla %></option><% }) %></select></label><label>Ano<input type="number" name="ano" value="<%= item.ano %>" min="2000" max="2100"></label></div><label>Status<select name="ativa"><option value="true" <%= item.ativa?'selected':'' %>>Ativa</option><option value="false" <%= !item.ativa?'selected':'' %>>Inativa</option></select></label><div class="form-acoes"><button class="btn btn-primario">Salvar</button></div></form><form class="admin-excluir" method="post" action="/admin/turmas/<%= item.id %>/excluir" data-confirm="Excluir esta turma? Turmas com alunos ou TCCs serão apenas desativadas."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-texto-perigo"><i class="fa-regular fa-trash-can"></i> Excluir turma</button></form></div></details><% }) %></div></div></div></section>
<%- include('../partials/footer') %>

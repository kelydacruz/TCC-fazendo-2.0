<%- include('../cabecalho') %>
<section class="page-hero admin-hero"><div class="container"><span class="eyebrow">Administração</span><h1>Trilha de aprendizagem</h1><p>Edite o conteúdo de orientação sem sobrecarregar a página.</p></div></section>
<%- include('nav') %>
<section class="secao container narrow"><div class="secao-titulo"><div><h2>Módulos</h2><p><%= modulos.length %> etapas cadastradas</p></div><details class="admin-criar"><summary class="btn btn-primario"><i class="fa-solid fa-plus"></i> Novo módulo</summary><form class="form-card" method="post" action="/admin/modulos"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Ordem<input type="number" name="ordem" required></label><label>Título<input name="titulo" required></label><label>Explicação<textarea name="explicacao" rows="6" required></textarea></label><label>Exemplo<textarea name="exemplo" rows="4"></textarea></label><label>Dicas <small>(uma por linha)</small><textarea name="dicas"></textarea></label><label>Erros comuns <small>(um por linha)</small><textarea name="errosComuns"></textarea></label><label>Material URL<input name="materialUrl" placeholder="/public/materiais/arquivo.md"></label><button class="btn btn-primario">Adicionar módulo</button></form></details></div><div class="admin-lista"><% modulos.forEach(item=>{ %><details class="admin-item"><summary><div><strong><%= String(item.ordem).padStart(2,'0') %>. <%= item.titulo %></strong><small><%= item.dicas.length %> dicas · <%= item.errosComuns.length %> erros comuns</small></div><div class="admin-item-meta"><span class="status <%= item.publicado?'disponivel':'' %>"><%= item.publicado?'Publicado':'Oculto' %></span><i class="fa-solid fa-chevron-down"></i></div></summary><div class="admin-item-conteudo"><form method="post" action="/admin/modulos/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><label>Ordem<input type="number" name="ordem" value="<%= item.ordem %>" required></label><label>Status<select name="publicado"><option value="true" <%= item.publicado?'selected':'' %>>Publicado</option><option value="false" <%= !item.publicado?'selected':'' %>>Oculto</option></select></label></div><label>Título<input name="titulo" value="<%= item.titulo %>" required></label><label>Explicação<textarea name="explicacao" rows="7" required><%= item.explicacao %></textarea></label><label>Exemplo<textarea name="exemplo" rows="4"><%= item.exemplo||'' %></textarea></label><div class="form-grid"><label>Dicas<textarea name="dicas" rows="5"><%= item.dicas.join('\n') %></textarea></label><label>Erros comuns<textarea name="errosComuns" rows="5"><%= item.errosComuns.join('\n') %></textarea></label></div><label>Material URL<input name="materialUrl" value="<%= item.materialUrl||'' %>"></label><div class="form-acoes"><button class="btn btn-primario">Salvar módulo</button></div></form><form class="admin-excluir" method="post" action="/admin/modulos/<%= item.id %>/excluir" data-confirm="Excluir este módulo da trilha e remover os registros de progresso associados?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-texto-perigo"><i class="fa-regular fa-trash-can"></i> Excluir módulo</button></form></div></details><% }) %></div></section>
<%- include('../rodape') %>

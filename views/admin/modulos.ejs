<%- include('../partials/header') %><section class="page-hero"><div class="container"><h1>Gerenciar trilha</h1></div></section><section class="secao container narrow"><details class="form-card"><summary><strong>Adicionar módulo</strong></summary><form method="post" action="/admin/modulos"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Ordem<input type="number" name="ordem" required></label><label>Título<input name="titulo" required></label><label>Explicação<textarea name="explicacao" rows="6" required></textarea></label><label>Exemplo<textarea name="exemplo" rows="4"></textarea></label><label>Dicas <small>(uma por linha)</small><textarea name="dicas"></textarea></label><label>Erros comuns <small>(um por linha)</small><textarea name="errosComuns"></textarea></label><label>Material URL<input type="url" name="materialUrl"></label><button class="btn btn-primario">Adicionar</button></form></details><% modulos.forEach(item=>{ %><details class="form-card"><summary><strong><%= item.ordem %>. <%= item.titulo %></strong></summary><form method="post" action="/admin/modulos/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Ordem<input type="number" name="ordem" value="<%= item.ordem %>"></label><label>Título<input name="titulo" value="<%= item.titulo %>"></label><label>Explicação<textarea name="explicacao" rows="6"><%= item.explicacao %></textarea></label><label>Exemplo<textarea name="exemplo"><%= item.exemplo||'' %></textarea></label><label>Dicas<textarea name="dicas"><%= item.dicas.join('\n') %></textarea></label><label>Erros comuns<textarea name="errosComuns"><%= item.errosComuns.join('\n') %></textarea></label><label>Material URL<input name="materialUrl" value="<%= item.materialUrl||'' %>"></label><label>Status<select name="publicado"><option value="true" <%= item.publicado?'selected':'' %>>Publicado</option><option value="false" <%= !item.publicado?'selected':'' %>>Oculto</option></select></label><button class="btn btn-primario">Salvar</button></form></details><% }) %></section><%- include('../partials/footer') %>

<%- include('../partials/header') %><section class="page-hero"><div class="container"><h1>Denúncias</h1></div></section><section class="secao container"><div class="tabela-wrap"><table><thead><tr><th>Comentário</th><th>Motivo</th><th>Denunciante</th><th>Status</th><th></th></tr></thead><tbody><% denuncias.forEach(item=>{ const formId='denuncia-'+item.id; %><tr><td><form id="<%= formId %>" method="post" action="/admin/denuncias/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><%= item.comentario?.texto||'Comentário removido' %><small><%= item.comentario?.autor?.nome %></small></td><td><%= item.motivo %></td><td><%= item.denunciante?.nome %></td><td><select form="<%= formId %>" name="status"><% ['Pendente','Analisada','Descartada'].forEach(i=>{ %><option <%= item.status===i?'selected':'' %>><%= i %></option><% }) %></select></td><td><button form="<%= formId %>" class="btn btn-claro">Salvar</button></td></tr><% }) %></tbody></table></div></section><%- include('../partials/footer') %>

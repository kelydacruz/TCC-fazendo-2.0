<%- include('../partials/header') %><section class="page-hero"><div class="container"><h1>Gerenciar usuários</h1><p>Aprove contas, ajuste perfis e bloqueie acessos.</p></div></section><section class="secao container"><div class="tabela-wrap"><table><thead><tr><th>Usuário</th><th>Perfil</th><th>Confirmação</th><th>Aprovação</th><th>Ativo</th><th></th></tr></thead><tbody><% usuarios.forEach(item=>{ const formId='usuario-'+item.id; %><tr><td><form id="<%= formId %>" method="post" action="/admin/usuarios/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><strong><%= item.nome %></strong><small><%= item.email %></small></td><td><select form="<%= formId %>" name="perfil"><% ['aluno','professor','administrador'].forEach(i=>{ %><option <%= item.perfil===i?'selected':'' %>><%= i %></option><% }) %></select></td><td><select form="<%= formId %>" name="emailConfirmado"><option value="true" <%= item.emailConfirmado?'selected':'' %>>Confirmado</option><option value="false" <%= !item.emailConfirmado?'selected':'' %>>Pendente</option></select></td><td><select form="<%= formId %>" name="aprovado"><option value="true" <%= item.aprovado?'selected':'' %>>Aprovado</option><option value="false" <%= !item.aprovado?'selected':'' %>>Pendente</option></select></td><td><select form="<%= formId %>" name="ativo"><option value="true" <%= item.ativo?'selected':'' %>>Ativo</option><option value="false" <%= !item.ativo?'selected':'' %>>Bloqueado</option></select></td><td><button form="<%= formId %>" class="btn btn-primario">Salvar</button></td></tr><% }) %></tbody></table></div></section><%- include('../partials/footer') %>

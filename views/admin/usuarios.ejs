<%- include('../cabecalho') %>
<section class="page-hero admin-hero"><div class="container"><span class="eyebrow">Administração</span><h1>Usuários</h1><p>Aprove contas e confirme o vínculo acadêmico de cada aluno.</p></div></section>
<%- include('nav') %>
<section class="secao container narrow"><div class="secao-titulo"><div><h2>Contas cadastradas</h2><p><%= usuarios.filter(item=>!item.aprovado).length %> aguardando aprovação</p></div></div><div class="admin-lista"><% usuarios.forEach(item=>{ %><details class="admin-item"><summary><div><strong><%= item.nome %></strong><small><%= item.email %></small></div><div class="admin-item-meta"><span class="perfil-badge"><%= item.perfil %></span><span class="status <%= item.aprovado&&item.ativo?'disponivel':'' %>"><%= !item.ativo?'Bloqueado':item.aprovado?'Aprovado':'Pendente' %></span><i class="fa-solid fa-chevron-down"></i></div></summary><div class="admin-item-conteudo"><form method="post" action="/admin/usuarios/<%= item.id %>" data-vinculo-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="admin-editor-grid"><label>Perfil<select name="perfil"><% ['aluno','professor','administrador'].forEach(i=>{ %><option value="<%= i %>" <%= item.perfil===i?'selected':'' %>><%= i %></option><% }) %></select></label><label>Curso do aluno<select name="curso"><option value="">Sem vínculo</option><% if(item.curso&&!cursos.some(i=>i.id===item.curso.id)){ %><option value="<%= item.curso.id %>" selected><%= item.curso.nome %> (inativo)</option><% } %><% cursos.forEach(i=>{ %><option value="<%= i.id %>" <%= String(item.curso?._id||'')===i.id?'selected':'' %>><%= i.nome %></option><% }) %></select></label><label>Turma do aluno<select name="turma"><option value="">Sem vínculo</option><% if(item.turma&&!turmas.some(i=>i.id===item.turma.id)){ %><option value="<%= item.turma.id %>" data-curso="<%= item.curso?.id %>" selected><%= item.turma.nome %> (inativa)</option><% } %><% turmas.forEach(i=>{ %><option value="<%= i.id %>" data-curso="<%= i.curso?.id %>" <%= String(item.turma?._id||'')===i.id?'selected':'' %>><%= i.nome %> · <%= i.curso?.sigla %> · <%= i.ano %></option><% }) %></select></label><label>E-mail<select name="emailConfirmado"><option value="true" <%= item.emailConfirmado?'selected':'' %>>Confirmado</option><option value="false" <%= !item.emailConfirmado?'selected':'' %>>Pendente</option></select></label><label>Aprovação<select name="aprovado"><option value="true" <%= item.aprovado?'selected':'' %>>Aprovado</option><option value="false" <%= !item.aprovado?'selected':'' %>>Pendente</option></select></label><label>Acesso<select name="ativo"><option value="true" <%= item.ativo?'selected':'' %>>Ativo</option><option value="false" <%= !item.ativo?'selected':'' %>>Bloqueado</option></select></label></div><p class="ajuda-admin"><i class="fa-solid fa-circle-info"></i> Curso e turma são obrigatórios para aprovar um aluno. Professores não precisam desse vínculo.</p><div class="form-acoes"><button class="btn btn-primario">Salvar usuário</button></div></form><% if(item.id!==usuarioAtual.id){ %><form class="admin-excluir" method="post" action="/admin/usuarios/<%= item.id %>/excluir" data-confirm="Excluir este usuário? Se houver conteúdo vinculado, a conta será apenas desativada."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-texto-perigo"><i class="fa-regular fa-trash-can"></i> Excluir usuário</button></form><% } %></div></details><% }) %></div></section>
<%- include('../rodape') %>

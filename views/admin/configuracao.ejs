<%- include('../partials/header') %><section class="page-hero"><div class="container"><h1>Configurações gerais</h1></div></section><section class="secao container narrow"><form class="form-card" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Instituição<input name="instituicao" value="<%= config.instituicao %>" required></label><label>Contato<input type="email" name="contato" value="<%= config.contato %>" required></label><label>Endereço<input name="endereco" value="<%= config.endereco||'' %>"></label><label>Política de privacidade<textarea name="privacidade" rows="8"><%= config.privacidade||'' %></textarea></label><label>Cadastro público<select name="permitirCadastro"><option value="true" <%= config.permitirCadastro?'selected':'' %>>Permitido</option><option value="false" <%= !config.permitirCadastro?'selected':'' %>>Bloqueado</option></select></label><label>Downloads públicos<select name="permitirDownloads"><option value="true" <%= config.permitirDownloads?'selected':'' %>>Permitidos</option><option value="false" <%= !config.permitirDownloads?'selected':'' %>>Bloqueados</option></select></label><button class="btn btn-primario">Salvar configurações</button></form></section><%- include('../partials/footer') %>

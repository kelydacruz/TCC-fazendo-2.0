<%- include('partials/header') %><section class="hero"><div class="container hero-grid"><div><span class="eyebrow"><i class="fa-solid fa-sparkles"></i> Conhecimento que transforma</span><h1>Conhecimento que inspira <em>novos projetos</em></h1><p>Explore Trabalhos de Conclusão de Curso, encontre referências e descubra ideias para construir o próximo grande projeto.</p><form class="busca" action="/tccs"><i class="fa-solid fa-magnifying-glass"></i><input name="q" aria-label="Pesquisar no acervo" placeholder="Pesquise por título, autor, tema ou palavra-chave"><button>Pesquisar</button></form><div class="filtros-rapidos"><span>Buscas populares:</span><a href="/tccs?area=Sustentabilidade">Sustentabilidade</a><a href="/tccs?curso=Desenvolvimento+de+Sistemas">Tecnologia</a><a href="/tccs?area=Empreendedorismo">Empreendedorismo</a></div></div><div class="hero-art" aria-hidden="true"><div class="orb orb1"></div><div class="orb orb2"></div><div class="livro"><i class="fa-solid fa-book-open"></i></div><span class="float-card fc1"><i class="fa-solid fa-lightbulb"></i> Ideias</span><span class="float-card fc2"><i class="fa-solid fa-chart-line"></i> Pesquisa</span><span class="float-card fc3"><i class="fa-solid fa-users"></i> Comunidade</span></div></div></section>
<section class="stats"><div class="container stats-grid"><div><strong>70+</strong><span>Trabalhos publicados</span></div><div><strong>4</strong><span>Cursos disponíveis</span></div><div><strong>12 mil+</strong><span>Visualizações</span></div><div><strong>3 mil+</strong><span>Downloads</span></div></div></section>
<section class="secao container"><div class="secao-titulo"><div><span class="eyebrow">Novos no acervo</span><h2>Publicados recentemente</h2><p>Conheça as pesquisas e soluções mais recentes da nossa comunidade.</p></div><a class="btn btn-outline" href="/tccs">Ver todos os trabalhos <i class="fa-solid fa-arrow-right"></i></a></div><div class="cards-grid"><% tccs.slice(0,3).forEach(item => { %><%- include('partials/tcc-card',{item}) %><% }) %></div></section>
<section class="secao fundo"><div class="container"><div class="secao-titulo central"><div><span class="eyebrow">Encontre sua área</span><h2>Explore por curso</h2><p>Navegue pelos trabalhos produzidos em cada formação.</p></div></div><div class="cursos-grid"><% cursos.forEach(curso => { %><a class="curso-card" href="/tccs?curso=<%= encodeURIComponent(curso.nome) %>"><span><i class="fa-solid fa-<%= curso.icone %>"></i></span><h3><%= curso.nome %></h3><p><%= curso.total %> trabalhos</p><i class="fa-solid fa-arrow-right"></i></a><% }) %></div></div></section>
<section class="secao container dois-blocos"><article class="chamada chamada-azul"><span class="icone-grande"><i class="fa-solid fa-route"></i></span><div><span class="eyebrow">Trilha de aprendizagem</span><h2>Aprenda a fazer seu TCC</h2><p>Do tema à apresentação: avance por uma trilha prática, com exemplos, dicas e checklists.</p><a class="btn btn-branco" href="/aprender">Começar a aprender <i class="fa-solid fa-arrow-right"></i></a></div></article><article class="chamada chamada-clara"><span class="icone-grande"><i class="fa-regular fa-lightbulb"></i></span><div><span class="eyebrow">Inspire e colabore</span><h2>Banco de Ideias</h2><p>Descubra desafios reais ou compartilhe uma proposta que pode virar o próximo TCC.</p><a class="btn btn-primario" href="/ideias">Explorar ideias <i class="fa-solid fa-arrow-right"></i></a></div></article></section><%- include('partials/footer') %>

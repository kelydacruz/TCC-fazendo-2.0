<%- include('../partials/header') %><section class="secao container auth-wrap"><div class="auth-card"><h1>Crie sua conta</h1><p>Contas precisam confirmar o e-mail e ser aprovadas pela instituição.</p><form method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nome completo<input name="nome" required maxlength="120" autocomplete="name"></label><label>E-mail<input type="email" name="email" required autocomplete="email"></label><label>Perfil<select name="perfil" required><option value="aluno">Aluno</option><option value="professor">Professor</option></select></label><label>Senha<input type="password" name="senha" required minlength="8" autocomplete="new-password"></label><label>Confirme a senha<input type="password" name="confirmarSenha" required minlength="8" autocomplete="new-password"></label><button class="btn btn-primario largura">Criar conta</button></form><p>Já possui conta? <a href="/entrar"><strong>Entrar</strong></a></p></div></section><%- include('../partials/footer') %>

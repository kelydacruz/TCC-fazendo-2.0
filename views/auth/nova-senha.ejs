<%- include('../cabecalho') %>

<section class="secao container auth-wrap">
  <div class="auth-card">
    <h1>Defina uma nova senha</h1>

    <form method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label>
        Nova senha
        <input type="password" name="senha" required minlength="8" autocomplete="new-password">
      </label>

      <label>
        Confirme a senha
        <input type="password" name="confirmarSenha" required minlength="8" autocomplete="new-password">
      </label>

      <button class="btn btn-primario largura">Alterar senha</button>
    </form>
  </div>
</section>

<%- include('../rodape') %>

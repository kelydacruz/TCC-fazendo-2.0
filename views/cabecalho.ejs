<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#6d28d9">
    <meta name="description" content="Acervo institucional de Trabalhos de Conclusão de Curso">
    <title><%= title %> | AcervoTCC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/public/css/style.css">
    <link rel="stylesheet" href="/public/css/components.css">
</head>
<body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo">
        <div class="container nav">
            <a class="marca" href="/">
                <span class="marca-icone">
                    <i class="fa-solid fa-book-open"></i>
                </span>
                <span>
                    Acervo<strong>TCC</strong>
                    <small>Conhecimento que transforma</small>
                </span>
            </a>

            <button class="menu-btn" aria-label="Abrir menu" aria-expanded="false">
                <i class="fa-solid fa-bars"></i>
            </button>

            <nav class="menu" aria-label="Navegação principal">
                <a class="<%= caminhoAtual === '/' ? 'ativo' : '' %>" href="/">Início</a>
                <a href="/tccs">TCCs</a>
                <a href="/aprender">Aprenda</a>
                <% if (usuarioAtual) { %>
                    <a href="/ideias">Banco de Ideias</a>
                    <a href="/painel">Painel</a>
                <% } %>
            </nav>

            <div class="acoes">
                <% if (usuarioAtual) { %>
                    <span class="usuario-mini"><%= usuarioAtual.nome.split(' ')[0] %></span>
                    <form method="post" action="/sair">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-claro" aria-label="Sair">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        </button>
                    </form>
                <% } else { %>
                    <a class="btn btn-claro" href="/entrar">
                        <i class="fa-regular fa-user"></i> Entrar
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <% if (mensagens.length) { %>
        <div class="mensagens container">
            <% mensagens.forEach(item => { %>
                <div class="alerta <%= item.tipo %>">
                    <i class="fa-solid fa-<%= item.tipo === 'sucesso' ? 'circle-check' : 'circle-exclamation' %>"></i>
                    <%= item.mensagem %>
                </div>
            <% }) %>
        </div>
    <% } %>

    <main id="conteudo">

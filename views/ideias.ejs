<%- include('partials/header') %><section class="page-hero ideias-hero"><div class="container page-flex"><div><span class="eyebrow">Colaboração que gera projetos</span><h1>Banco de Ideias</h1><p>Encontre uma inspiração para seu TCC ou compartilhe um desafio com a comunidade.</p></div><a class="btn btn-branco" href="/painel"><i class="fa-solid fa-plus"></i> Publicar uma ideia</a></div></section><section class="secao container"><form class="busca busca-pagina"><i class="fa-solid fa-magnifying-glass"></i><input placeholder="Pesquise ideias por tema, curso ou problema"><button>Buscar</button></form><div class="chips"><button class="ativo">Todas</button><button>Disponíveis</button><button>Em análise</button><button>Reservadas</button><button>Em desenvolvimento</button></div><div class="ideias-grid"><% ideias.forEach(ideia => { %><article class="card ideia-card"><div class="ideia-topo"><span class="status <%= ideia.status.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replaceAll(' ','-') %>"><%= ideia.status %></span><button aria-label="Salvar ideia"><i class="fa-regular fa-bookmark"></i></button></div><h2><%= ideia.titulo %></h2><p><%= ideia.descricao %></p><div class="ideia-dados"><span><i class="fa-solid fa-graduation-cap"></i> <%= ideia.curso %></span><span><i class="fa-solid fa-signal"></i> <%= ideia.dificuldade %></span></div><div class="ideia-rodape"><span><i class="fa-regular fa-user"></i> <%= ideia.autor %></span><span><%= ideia.data %></span></div></article><% }) %></div></section><%- include('partials/footer') %>

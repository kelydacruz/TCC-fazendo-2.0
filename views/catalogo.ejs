<%- include('partials/header') %><section class="page-hero"><div class="container"><span class="eyebrow">Repositório de conhecimento</span><h1>Acervo de TCCs</h1><p>Encontre projetos, pesquisas e soluções desenvolvidos por nossos estudantes.</p><form class="busca busca-interna"><i class="fa-solid fa-magnifying-glass"></i><input name="q" value="<%= query.q || '' %>" placeholder="Título, autor, orientador ou palavra-chave"><button>Pesquisar</button></form></div></section><section class="secao container catalogo-layout"><aside class="filtro"><form action="/tccs"><h2>Filtros</h2><label>Curso<select name="curso"><option value="">Todos os cursos</option><% cursos.forEach(c => { %><option <%= query.curso===c.nome?'selected':'' %>><%= c.nome %></option><% }) %></select></label><label>Ano<select name="ano"><option value="">Todos os anos</option><% [...new Set(tccs.map(t=>t.ano))].forEach(a => { %><option <%= String(query.ano)===String(a)?'selected':'' %>><%= a %></option><% }) %></select></label><label>Área<select name="area"><option value="">Todas as áreas</option><% [...new Set(tccs.map(t=>t.area))].forEach(a => { %><option <%= query.area===a?'selected':'' %>><%= a %></option><% }) %></select></label><label>Orientador<select name="orientador"><option value="">Todos</option><% [...new Set(tccs.map(t=>t.orientador))].forEach(o => { %><option <%= query.orientador===o?'selected':'' %>><%= o %></option><% }) %></select></label><button class="btn btn-primario largura">Aplicar filtros</button><a class="limpar" href="/tccs">Limpar todos</a></form></aside><div><div class="resultado-topo"><p><strong><%= resultado.length %></strong> trabalho<%= resultado.length===1?'':'s' %> encontrado<%= resultado.length===1?'':'s' %></p><form><% Object.entries(query).filter(([k])=>k!=='ordem').forEach(([k,v])=>{ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %><select name="ordem" onchange="this.form.submit()"><option value="recentes">Mais recentes</option><option value="visualizados" <%= query.ordem==='visualizados'?'selected':'' %>>Mais visualizados</option><option value="az" <%= query.ordem==='az'?'selected':'' %>>Ordem alfabética</option></select></form></div><div class="cards-grid cards-2"><% resultado.forEach(item => { %><%- include('partials/tcc-card',{item}) %><% }) %></div><% if(!resultado.length){ %><div class="vazio"><i class="fa-regular fa-folder-open"></i><h2>Nenhum trabalho encontrado</h2><p>Tente remover alguns filtros ou pesquisar com outros termos.</p><a class="btn btn-primario" href="/tccs">Limpar busca</a></div><% } %></div></section><%- include('partials/footer') %>

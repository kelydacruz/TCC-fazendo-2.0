<article class="card tcc-card"><div class="capa capa-<%= item.cor %>"><span><%= item.curso %></span><i class="fa-solid fa-graduation-cap"></i></div><div class="card-conteudo"><div class="meta"><span><i class="fa-regular fa-calendar"></i> <%= item.ano %></span><span><i class="fa-regular fa-eye"></i> <%= item.views.toLocaleString('pt-BR') %></span></div><h3><a href="/tccs/<%= item.id %>"><%= item.titulo %></a></h3><p><%= item.resumo %></p><div class="tags"><% item.palavras.slice(0,3).forEach(tag => { %><span><%= tag %></span><% }) %></div><a class="card-link" href="/tccs/<%= item.id %>">Ver trabalho <i class="fa-solid fa-arrow-right"></i></a></div></article>

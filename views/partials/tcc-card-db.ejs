<article class="card tcc-card">
    <div
        class="capa capa-azul"
        <% if (item.capa?.mime) { %>
            style="background-image:linear-gradient(0deg,rgba(7,35,82,.65),rgba(7,35,82,.15)),url('/tccs/<%= item.id %>/capa');background-size:cover"
        <% } %>
    >
        <span><%= item.curso?.nome || 'Curso' %></span>
        <i class="fa-solid fa-graduation-cap"></i>
    </div>

    <div class="card-conteudo">
        <div class="meta">
            <span><i class="fa-regular fa-calendar"></i> <%= item.ano %></span>
            <span><i class="fa-regular fa-eye"></i> <%= (item.visualizacoes || 0).toLocaleString('pt-BR') %></span>
        </div>

        <h3><a href="/tccs/<%= item.id %>"><%= item.titulo %></a></h3>
        <p><%= item.resumo %></p>

        <div class="tags">
            <% item.palavrasChave.slice(0, 3).forEach(tag => { %>
                <span><%= tag %></span>
            <% }) %>
        </div>

        <a class="card-link" href="/tccs/<%= item.id %>">
            Ver trabalho <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
</article>

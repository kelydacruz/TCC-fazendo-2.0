<%- include('../partials/header') %><section class="page-hero ideias-hero"><div class="container page-flex"><div><span class="eyebrow">Colaboração que gera projetos</span><h1>Banco de Ideias</h1><p>Encontre inspiração ou compartilhe um desafio com a comunidade.</p></div><% if(usuarioAtual){ %><a class="btn btn-branco" href="/ideias/nova"><i class="fa-solid fa-plus"></i> Publicar ideia</a><% } %></div></section><section class="secao container"><form class="busca busca-pagina"><i class="fa-solid fa-magnifying-glass"></i><input name="q" value="<%= query.q||'' %>" placeholder="Pesquise por tema ou problema"><button>Buscar</button></form><div class="filtros-linha"><select name="curso" form="filtroIdeias"><option value="">Todos os cursos</option><% cursos.forEach(i=>{ %><option value="<%= i.id %>"><%= i.nome %></option><% }) %></select><select name="area" form="filtroIdeias"><option value="">Todas as áreas</option><% areas.forEach(i=>{ %><option><%= i %></option><% }) %></select><select name="dificuldade" form="filtroIdeias"><option value="">Toda dificuldade</option><option>Iniciante</option><option>Intermediária</option><option>Avançada</option></select><select name="status" form="filtroIdeias"><option value="">Todos os status</option><% statusIdeia.forEach(i=>{ %><option><%= i %></option><% }) %></select><form id="filtroIdeias"><button class="btn btn-outline">Filtrar</button></form></div><div class="ideias-grid"><% ideias.forEach(ideia=>{ %><article class="card ideia-card"><div class="ideia-topo"><span class="status <%= ideia.status.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replaceAll(' ','-') %>"><%= ideia.status %></span><span><i class="fa-regular fa-comment"></i></span></div><h2><a href="/ideias/<%= ideia.id %>"><%= ideia.titulo %></a></h2><p><%= ideia.descricao %></p><div class="ideia-dados"><span><i class="fa-solid fa-graduation-cap"></i> <%= ideia.curso?.nome %></span><span><i class="fa-solid fa-signal"></i> <%= ideia.dificuldade %></span></div><div class="ideia-rodape"><span><%= ideia.autor?.nome %></span><a href="/ideias/<%= ideia.id %>">Ver detalhes</a></div></article><% }) %></div><% if(!ideias.length){ %><div class="vazio"><h2>Nenhuma ideia encontrada</h2></div><% } %></section><%- include('../partials/footer') %>

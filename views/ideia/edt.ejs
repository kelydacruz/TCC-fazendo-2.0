<%- include('../partials/header') %><section class="page-hero"><div class="container"><h1>Editar ideia</h1></div></section><section class="secao container narrow"><form class="form-card" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Título<input name="titulo" required value="<%= ideia.titulo %>"></label><label>Descrição<textarea name="descricao" rows="6" required><%= ideia.descricao %></textarea></label><label>Problema<textarea name="problema" rows="4" required><%= ideia.problema %></textarea></label><div class="form-grid"><label>Curso<select name="curso"><% cursos.forEach(i=>{ %><option value="<%= i.id %>" <%= String(ideia.curso)===i.id?'selected':'' %>><%= i.nome %></option><% }) %></select></label><label>Área<input name="area" value="<%= ideia.area %>"></label><label>Dificuldade<select name="dificuldade"><% ['Iniciante','Intermediária','Avançada'].forEach(i=>{ %><option <%= ideia.dificuldade===i?'selected':'' %>><%= i %></option><% }) %></select></label><label>Conhecimentos<input name="conhecimentos" value="<%= ideia.conhecimentos.join(', ') %>"></label><% if(['professor','administrador'].includes(usuarioAtual.perfil)){ %><label>Status<select name="status"><% ['Disponível','Em análise','Reservada','Em desenvolvimento','Utilizada','Arquivada'].forEach(i=>{ %><option <%= ideia.status===i?'selected':'' %>><%= i %></option><% }) %></select></label><label>TCC vinculado<select name="tccVinculado"><option value="">Nenhum</option><% tccs.forEach(i=>{ %><option value="<%= i.id %>" <%= String(ideia.tccVinculado||'')===i.id?'selected':'' %>><%= i.titulo %></option><% }) %></select></label><% } %></div><button class="btn btn-primario">Salvar alterações</button></form><form class="form-perigo" method="post" action="/ideias/<%= ideia.id %>/excluir" data-confirm="Excluir esta ideia e seus comentários?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-perigo">Excluir ideia</button></form></section><%- include('../partials/footer') %>

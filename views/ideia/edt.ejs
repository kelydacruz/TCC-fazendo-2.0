<%- include('../partials/header') %>
<section class="page-hero"><div class="container"><span class="eyebrow"><%= ['professor','administrador'].includes(usuarioAtual.perfil)?'Moderação':'Sua ideia' %></span><h1>Editar ideia</h1><p>Atualize os dados da proposta e acompanhe sua utilização.</p></div></section>
<section class="secao container narrow">
  <form class="form-card" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Título<input name="titulo" required maxlength="200" value="<%= ideia.titulo %>"></label>
    <label>Descrição<textarea name="descricao" rows="6" required maxlength="5000"><%= ideia.descricao %></textarea></label>
    <label>Problema<textarea name="problema" rows="4" required maxlength="3000"><%= ideia.problema %></textarea></label>
    <div class="form-grid">
      <label>Curso<select name="curso" required><% cursos.forEach(item=>{ %><option value="<%= item.id %>" <%= String(ideia.curso)===item.id?'selected':'' %>><%= item.nome %></option><% }) %></select></label>
      <label>Área<input name="area" required value="<%= ideia.area %>"></label>
      <label>Dificuldade<select name="dificuldade"><% ['Iniciante','Intermediária','Avançada'].forEach(item=>{ %><option <%= ideia.dificuldade===item?'selected':'' %>><%= item %></option><% }) %></select></label>
      <label>Conhecimentos<input name="conhecimentos" value="<%= ideia.conhecimentos.join(', ') %>"></label>
    </div>
    <% if(['professor','administrador'].includes(usuarioAtual.perfil)){ %>
      <div class="subsecao moderacao-ideia" data-uso-ideia>
        <h2>Uso da ideia</h2>
        <p>Somente professores e administradores confirmam quando uma ideia foi reservada, está em desenvolvimento ou já foi utilizada.</p>
        <div class="form-grid">
          <label>Status<select name="status" data-status-ideia><% statusIdeia.forEach(item=>{ %><option value="<%= item %>" <%= ideia.status===item?'selected':'' %>><%= item %></option><% }) %></select></label>
          <label>Usuário responsável<select name="responsavelUso"><option value="">Nenhum</option><% usuariosUso.forEach(item=>{ %><option value="<%= item.id %>" <%= String(ideia.responsavelUso||'')===item.id?'selected':'' %>><%= item.nome %> · <%= item.perfil %></option><% }) %></select><small>Obrigatório para ideias reservadas, em desenvolvimento ou utilizadas.</small></label>
          <label class="span-2">TCC desenvolvido a partir da ideia<select name="tccVinculado"><option value="">Nenhum TCC vinculado</option><% tccs.forEach(item=>{ %><option value="<%= item.id %>" <%= String(ideia.tccVinculado||'')===item.id?'selected':'' %>><%= item.titulo %></option><% }) %></select><small>Este vínculo é exibido quando o status estiver como “Utilizada”.</small></label>
        </div>
      </div>
    <% } %>
    <button class="btn btn-primario">Salvar alterações</button>
  </form>
  <form class="form-perigo" method="post" action="/ideias/<%= ideia.id %>/excluir" data-confirm="Excluir esta ideia e seus comentários?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-perigo">Excluir ideia</button>
  </form>
</section>
<%- include('../partials/footer') %>

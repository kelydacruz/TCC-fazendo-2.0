<%- include('../cabecalho') %>

<%
  const statusClasse = ideia.status
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replaceAll(' ', '-');
%>

<section class="detalhe-hero">
  <div class="container">
    <a class="voltar" href="/ideias">
      <i class="fa-solid fa-arrow-left"></i> Banco de Ideias
    </a>

    <div class="breadcrumb">
      <span class="status <%= statusClasse %>"><%= ideia.status %></span>
      <span><%= ideia.curso?.nome %></span>
    </div>

    <h1><%= ideia.titulo %></h1>
    <p>
      Publicada por <strong><%= ideia.autor?.nome %></strong>
      <span class="perfil-badge"><%= ideia.autor?.perfil %></span>
      em <%= new Date(ideia.createdAt).toLocaleDateString('pt-BR') %>
    </p>
  </div>
</section>

<section class="secao container detalhe-grid">
  <article>
    <h2>Descrição</h2>
    <p class="resumo"><%= ideia.descricao %></p>

    <h2>Problema que pretende resolver</h2>
    <p class="resumo"><%= ideia.problema %></p>

    <h2>Conhecimentos recomendados</h2>
    <div class="tags">
      <% ideia.conhecimentos.forEach(item => { %>
        <span><%= item %></span>
      <% }) %>
    </div>

    <% if (ideia.tccVinculado) { %>
      <div class="aviso">
        <i class="fa-solid fa-link"></i>
        <div>
          <h2>TCC desenvolvido a partir desta ideia</h2>
          <a href="/tccs/<%= ideia.tccVinculado.id %>"><%= ideia.tccVinculado.titulo %></a>
        </div>
      </div>
    <% } %>
  </article>

  <aside class="download-box">
    <span class="status <%= statusClasse %>"><%= ideia.status %></span>
    <h2><%= descricaoUso %></h2>

    <% if (ideia.responsavelUso) { %>
      <p>
        Responsável: <strong><%= ideia.responsavelUso.nome %></strong>
        <span class="perfil-badge"><%= ideia.responsavelUso.perfil %></span>
      </p>
    <% } %>
    <p>Dificuldade: <strong><%= ideia.dificuldade %></strong></p>

    <% if (usuarioAtual.perfil === 'aluno' && (acoesAluno.length || alunoResponsavel)) { %>
      <div class="acoes-ideia-aluno">
        <h3><%= alunoResponsavel ? 'Você escolheu esta ideia' : 'Quer desenvolver esta ideia?' %></h3>
        <p><%= alunoResponsavel ? 'Atualize o andamento ou libere a proposta para outro aluno.' : 'Ao escolher, ela ficará reservada para você.' %></p>

        <% acoesAluno.forEach(item => { %>
          <form
            method="post"
            action="/ideias/<%= ideia.id %>/status"
            data-confirm="<%= item.confirmacao %>"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="acao" value="<%= item.acao %>">
            <button class="btn <%= item.acao === 'liberar' ? 'btn-outline' : 'btn-primario' %> largura">
              <%= item.rotulo %>
            </button>
          </form>
        <% }) %>

        <% if (alunoResponsavel && ideia.status === 'Utilizada') { %>
          <span class="ideia-concluida">
            <i class="fa-solid fa-circle-check"></i> Projeto concluído
          </span>
        <% } %>
      </div>
    <% } %>

    <form method="post" action="/ideias/<%= ideia.id %>/favorito">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-claro largura">
        <i class="fa-<%= favorito ? 'solid' : 'regular' %> fa-bookmark"></i>
        <%= favorito ? 'Remover dos favoritos' : 'Salvar ideia' %>
      </button>
    </form>

    <% if (['professor', 'administrador'].includes(usuarioAtual.perfil)) { %>
      <a class="btn btn-outline largura" href="/ideias/<%= ideia.id %>/editar">
        <i class="fa-solid fa-shield-halved"></i> Revisar e moderar
      </a>
    <% } else if (String(ideia.autor?._id) === usuarioAtual.id && ideia.status === 'Disponível') { %>
      <a class="btn btn-outline largura" href="/ideias/<%= ideia.id %>/editar">
        <i class="fa-regular fa-pen-to-square"></i> Editar minha ideia
      </a>
    <% } %>
  </aside>
</section>

<section id="comentarios" class="secao fundo">
  <div class="container narrow">
    <h2>Comentários (<%= comentarios.length %>)</h2>

    <form class="form-card comentario-form" method="post" action="/ideias/<%= ideia.id %>/comentarios">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>
        Novo comentário
        <textarea
          name="texto"
          rows="3"
          required
          minlength="2"
          maxlength="1500"
          placeholder="Contribua de forma respeitosa e objetiva"
        ></textarea>
      </label>
      <button class="btn btn-primario">Comentar</button>
    </form>

    <div class="comentarios">
      <% comentarios.forEach(comentario => { %>
        <article>
          <div class="comentario-topo">
            <div>
              <strong><%= comentario.autor?.nome %></strong>
              <span class="perfil-badge"><%= comentario.autor?.perfil || 'usuário' %></span>
            </div>
            <small><%= new Date(comentario.createdAt).toLocaleString('pt-BR') %></small>
          </div>

          <p><%= comentario.texto %></p>
          <div class="comentario-acoes">
            <% if (String(comentario.autor?._id) === usuarioAtual.id) { %>
              <form
                method="post"
                action="/comentarios/<%= comentario.id %>/excluir"
                data-confirm="Excluir seu comentário?"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button>Excluir</button>
              </form>
            <% } else { %>
              <details>
                <summary>Denunciar</summary>
                <form method="post" action="/comentarios/<%= comentario.id %>/denunciar">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input name="motivo" placeholder="Informe o motivo" required maxlength="500">
                  <button>Enviar denúncia</button>
                </form>
              </details>
            <% } %>

            <% if (['professor', 'administrador'].includes(usuarioAtual.perfil)) { %>
              <form
                method="post"
                action="/comentarios/<%= comentario.id %>/moderar"
                data-confirm="Ocultar este comentário?"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="acao" value="ocultar">
                <button>Ocultar como moderador</button>
              </form>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../rodape') %>

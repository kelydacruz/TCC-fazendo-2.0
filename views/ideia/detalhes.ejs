<%- include('../partials/header') %>
<section class="detalhe-hero"><div class="container"><a class="voltar" href="/ideias"><i class="fa-solid fa-arrow-left"></i> Banco de Ideias</a><div class="breadcrumb"><span class="status <%= ideia.status.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replaceAll(' ','-') %>"><%= ideia.status %></span><span><%= ideia.curso?.nome %></span></div><h1><%= ideia.titulo %></h1><p>Publicada por <strong><%= ideia.autor?.nome %></strong> <span class="perfil-badge"><%= ideia.autor?.perfil %></span> em <%= new Date(ideia.createdAt).toLocaleDateString('pt-BR') %></p></div></section>
<section class="secao container detalhe-grid"><article><h2>Descrição</h2><p class="resumo"><%= ideia.descricao %></p><h2>Problema que pretende resolver</h2><p class="resumo"><%= ideia.problema %></p><h2>Conhecimentos recomendados</h2><div class="tags"><% ideia.conhecimentos.forEach(i=>{ %><span><%= i %></span><% }) %></div><% if(ideia.tccVinculado){ %><div class="aviso"><i class="fa-solid fa-link"></i><div><h2>Ideia utilizada</h2><a href="/tccs/<%= ideia.tccVinculado.id %>"><%= ideia.tccVinculado.titulo %></a></div></div><% } %></article><aside class="download-box"><h2><%= ideia.status %></h2><p>Dificuldade: <strong><%= ideia.dificuldade %></strong></p><% if(usuarioAtual){ %><form method="post" action="/ideias/<%= ideia.id %>/favorito"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-claro largura"><i class="fa-regular fa-bookmark"></i> Salvar ideia</button></form><% if(String(ideia.autor?._id)===usuarioAtual.id||['professor','administrador'].includes(usuarioAtual.perfil)){ %><a class="btn btn-outline largura" href="/ideias/<%= ideia.id %>/editar">Editar/Moderar</a><% } %><% } %></aside></section>
<section id="comentarios" class="secao fundo"><div class="container narrow"><h2>Comentários (<%= comentarios.length %>)</h2><% if(usuarioAtual){ %><form class="form-card comentario-form" method="post" action="/ideias/<%= ideia.id %>/comentarios"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Adicionar comentário<textarea name="texto" required minlength="2" maxlength="1500" rows="3" placeholder="Contribua de forma respeitosa e objetiva"></textarea></label><button class="btn btn-primario">Publicar</button></form><% }else{ %><p><a href="/entrar"><strong>Entre</strong></a> para comentar.</p><% } %><div class="comentarios"><% comentarios.forEach(item=>{ %><article><div class="comentario-topo"><div><strong><%= item.autor?.nome %></strong> <span class="perfil-badge"><%= item.autor?.perfil %></span></div><small><%= new Date(item.createdAt).toLocaleString('pt-BR') %></small></div><p><%= item.texto %></p><% if(usuarioAtual){ %><div class="comentario-acoes"><% if(String(item.autor?._id)===usuarioAtual.id){ %><form method="post" action="/comentarios/<%= item.id %>/excluir" data-confirm="Excluir definitivamente o seu comentário?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Excluir</button></form><% } %><% if(['professor','administrador'].includes(usuarioAtual.perfil)){ %><form method="post" action="/comentarios/<%= item.id %>/moderar" data-confirm="Ocultar este comentário da área pública?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="ocultar"><button>Ocultar como moderador</button></form><% } %><% if(String(item.autor?._id)!==usuarioAtual.id){ %><details><summary>Denunciar</summary><form method="post" action="/comentarios/<%= item.id %>/denunciar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="motivo" required maxlength="500" placeholder="Informe o motivo"><button>Enviar</button></form></details><% } %></div><% } %></article><% }) %></div></div></section>
<%- include('../partials/footer') %>

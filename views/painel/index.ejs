<%- include('../partials/header') %><section class="page-hero"><div class="container"><span class="eyebrow"><%= usuarioAtual.perfil %></span><h1>Olá, <%= usuarioAtual.nome.split(' ')[0] %></h1><p>Acompanhe suas atividades e acesse as ferramentas do seu perfil.</p></div></section><section class="secao container"><div class="atalhos"><a href="/tcc/lst"><i class="fa-regular fa-file-lines"></i><span><strong>Meus TCCs</strong>Acompanhar e revisar</span></a><a href="/ideias"><i class="fa-regular fa-lightbulb"></i><span><strong>Banco de Ideias</strong>Publicar e colaborar</span></a><a href="/aprender"><i class="fa-solid fa-route"></i><span><strong>Trilha</strong>Continuar aprendendo</span></a></div><h2>Visão geral</h2><div class="painel-cards"><% Object.entries(dados).filter(([,v])=>typeof v==='number').forEach(([chave,valor])=>{ %><article><i class="fa-solid fa-chart-simple"></i><span><strong><%= valor %></strong><%= chave.replace(/([A-Z])/g,' $1') %></span></article><% }) %></div><% if(usuarioAtual.perfil==='administrador'){ %><h2>Administração</h2><div class="atalhos"><a href="/admin/usuarios"><i class="fa-solid fa-users-gear"></i><span><strong>Usuários</strong>Aprovar contas e perfis</span></a><a href="/admin/cursos"><i class="fa-solid fa-graduation-cap"></i><span><strong>Cursos e turmas</strong>Gerenciar cadastros</span></a><a href="/admin/modulos"><i class="fa-solid fa-list-check"></i><span><strong>Módulos</strong>Editar a trilha</span></a><a href="/admin/denuncias"><i class="fa-solid fa-shield-halved"></i><span><strong>Denúncias</strong>Moderar conteúdo</span></a><a href="/admin/configuracao"><i class="fa-solid fa-sliders"></i><span><strong>Configurações</strong>Dados institucionais</span></a></div><% } %></section><%- include('../partials/footer') %>

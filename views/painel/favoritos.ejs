<%- include('../partials/header') %>
<section class="page-hero">
  <div class="container page-flex">
    <div><span class="eyebrow">Sua biblioteca</span><h1>Meus favoritos</h1><p>Consulte e organize os TCCs e as ideias que você salvou.</p></div>
    <a class="btn btn-branco" href="/painel"><i class="fa-solid fa-arrow-left"></i> Voltar ao painel</a>
  </div>
</section>
<section class="secao container">
  <div class="secao-titulo"><div><span class="eyebrow">Trabalhos salvos</span><h2>TCCs favoritos</h2><p><%= tccs.length %> <%= tccs.length===1?'trabalho salvo':'trabalhos salvos' %></p></div><a class="btn btn-outline" href="/tccs">Explorar TCCs</a></div>
  <div class="cards-grid"><% tccs.forEach(item=>{ %><article class="card tcc-card"><div class="capa"><span><%= item.curso?.nome||'Curso' %></span><i class="fa-solid fa-graduation-cap"></i></div><div class="card-conteudo"><div class="meta"><span><i class="fa-regular fa-calendar"></i> <%= item.ano %></span><span><i class="fa-regular fa-eye"></i> <%= item.visualizacoes||0 %></span></div><h3><a href="/tccs/<%= item.id %>"><%= item.titulo %></a></h3><p><%= item.resumo %></p><form method="post" action="/tccs/<%= item.id %>/favorito"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-claro largura"><i class="fa-solid fa-bookmark"></i> Remover dos favoritos</button></form></div></article><% }) %></div>
  <% if(!tccs.length){ %><div class="vazio"><i class="fa-regular fa-bookmark"></i><h3>Nenhum TCC favorito</h3><p>Abra um trabalho publicado e use o botão “Salvar favorito”.</p></div><% } %>
</section>
<section class="secao fundo">
  <div class="container">
    <div class="secao-titulo"><div><span class="eyebrow">Inspirações salvas</span><h2>Ideias favoritas</h2><p><%= ideias.length %> <%= ideias.length===1?'ideia salva':'ideias salvas' %></p></div><a class="btn btn-outline" href="/ideias">Explorar ideias</a></div>
    <div class="ideias-grid"><% ideias.forEach(ideia=>{ %><article class="card ideia-card"><div class="ideia-topo"><span class="status"><%= ideia.status %></span><span><i class="fa-regular fa-calendar"></i> <%= new Date(ideia.createdAt).toLocaleDateString('pt-BR') %></span></div><h2><a href="/ideias/<%= ideia.id %>"><%= ideia.titulo %></a></h2><p><%= ideia.descricao %></p><div class="ideia-dados"><span><i class="fa-solid fa-graduation-cap"></i> <%= ideia.curso?.nome||'Curso' %></span><span><i class="fa-solid fa-signal"></i> <%= ideia.dificuldade %></span></div><form method="post" action="/ideias/<%= ideia.id %>/favorito"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-claro largura"><i class="fa-solid fa-bookmark"></i> Remover dos favoritos</button></form></article><% }) %></div>
    <% if(!ideias.length){ %><div class="vazio"><i class="fa-regular fa-lightbulb"></i><h3>Nenhuma ideia favorita</h3><p>Abra uma ideia e use o botão “Salvar ideia”.</p></div><% } %>
  </div>
</section>
<%- include('../partials/footer') %>

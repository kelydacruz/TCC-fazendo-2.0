<%- include('partials/header') %>
<section class="page-hero"><div class="container"><span class="eyebrow">Repositório de conhecimento</span><h1>Acervo de TCCs</h1><form class="busca busca-interna"><input type="hidden" name="curso" value="<%= query.curso||'' %>"><input type="hidden" name="turma" value="<%= query.turma||'' %>"><input type="hidden" name="ano" value="<%= query.ano||'' %>"><input type="hidden" name="area" value="<%= query.area||'' %>"><input type="hidden" name="orientador" value="<%= query.orientador||'' %>"><input type="hidden" name="ordem" value="<%= query.ordem||'recentes' %>"><i class="fa-solid fa-magnifying-glass"></i><input name="q" value="<%= query.q||'' %>" aria-label="Pesquisar no acervo" placeholder="Título, autor, orientador ou palavra-chave"><button>Pesquisar</button></form></div></section>
<section class="secao container catalogo-layout"><aside class="filtro"><form><input type="hidden" name="q" value="<%= query.q||'' %>"><h2>Filtros</h2><label>Curso<select name="curso"><option value="">Todos</option><% cursos.forEach(i=>{ %><option value="<%= i.id %>" <%= String(query.curso||'')===String(i.id)?'selected':'' %>><%= i.nome %></option><% }) %></select></label><label>Turma<select name="turma"><option value="">Todas</option><% turmas.forEach(i=>{ %><option value="<%= i.id %>" <%= String(query.turma||'')===String(i.id)?'selected':'' %>><%= i.nome %> · <%= i.ano %></option><% }) %></select></label><label>Ano<input type="number" name="ano" value="<%= query.ano||'' %>" min="2000" max="2100"></label><label>Área<select name="area"><option value="">Todas</option><% areas.forEach(i=>{ %><option value="<%= i %>" <%= query.area===i?'selected':'' %>><%= i %></option><% }) %></select></label><label>Orientador<select name="orientador"><option value="">Todos</option><% orientadores.forEach(i=>{ %><option value="<%= i.id %>" <%= String(query.orientador||'')===String(i.id)?'selected':'' %>><%= i.nome %></option><% }) %></select></label><label>Ordem<select name="ordem"><option value="recentes" <%= !query.ordem||query.ordem==='recentes'?'selected':'' %>>Mais recentes</option><option value="visualizados" <%= query.ordem==='visualizados'?'selected':'' %>>Mais visualizados</option><option value="az" <%= query.ordem==='az'?'selected':'' %>>Ordem alfabética</option></select></label><button class="btn btn-primario largura">Aplicar filtros</button><a class="limpar" href="/tccs">Limpar todos</a></form></aside><div><div class="resultado-topo"><p><strong><%= resultado.length %></strong> <%= resultado.length===1?'trabalho encontrado':'trabalhos encontrados' %></p></div><div class="cards-grid cards-2"><% resultado.forEach(item=>{ %><%- include('partials/tcc-card-db',{item}) %><% }) %></div><% if(!resultado.length){ %><div class="vazio"><i class="fa-regular fa-folder-open"></i><h2>Nenhum trabalho encontrado</h2><a class="btn btn-primario" href="/tccs">Limpar busca</a></div><% } %></div></section>
<%- include('partials/footer') %>

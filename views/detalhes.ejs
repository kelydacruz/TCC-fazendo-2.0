<%- include('partials/header') %><section class="detalhe-hero"><div class="container"><a class="voltar" href="/tccs"><i class="fa-solid fa-arrow-left"></i> Voltar ao acervo</a><div class="breadcrumb"><span><%= tcc.curso %></span><i class="fa-solid fa-chevron-right"></i><span><%= tcc.ano %></span></div><h1><%= tcc.titulo %></h1><p class="autoria">Por <strong><%= tcc.autores.join(' e ') %></strong> · Orientação: <strong><%= tcc.orientador %></strong></p><div class="tags"><% tcc.palavras.forEach(tag => { %><span><%= tag %></span><% }) %></div></div></section><section class="secao container detalhe-grid"><article><h2>Resumo</h2><p class="resumo"><%= tcc.resumo %> O trabalho apresenta fundamentação teórica, levantamento de requisitos, desenvolvimento do protótipo e avaliação dos resultados obtidos junto ao público participante. A solução demonstra como conhecimentos técnicos podem ser aplicados a desafios reais da comunidade.</p><h2>Informações do trabalho</h2><dl class="info-grid"><div><dt>Curso</dt><dd><%= tcc.curso %></dd></div><div><dt>Turma</dt><dd><%= tcc.turma %></dd></div><div><dt>Ano de conclusão</dt><dd><%= tcc.ano %></dd></div><div><dt>Área</dt><dd><%= tcc.area %></dd></div><div><dt>Data de publicação</dt><dd><%= tcc.publicado %></dd></div><div><dt>Status</dt><dd><span class="status disponivel">Publicado</span></dd></div></dl></article><aside class="download-box"><div class="pdf-icon"><i class="fa-regular fa-file-pdf"></i></div><h2>Trabalho completo</h2><p>Consulte o documento completo em formato PDF.</p><a class="btn btn-primario largura" href="#" onclick="alert('Arquivo demonstrativo: conecte o armazenamento de PDFs para habilitar.');return false"><i class="fa-regular fa-eye"></i> Visualizar PDF</a><a class="btn btn-outline largura" href="#" onclick="alert('Download demonstrativo.');return false"><i class="fa-solid fa-download"></i> Baixar arquivo</a><button class="btn btn-claro largura copiar"><i class="fa-regular fa-copy"></i> Copiar link</button><div class="metricas"><span><strong><%= tcc.views.toLocaleString('pt-BR') %></strong> visualizações</span><span><strong><%= tcc.downloads.toLocaleString('pt-BR') %></strong> downloads</span></div></aside></section><% if(relacionados.length){ %><section class="secao fundo"><div class="container"><div class="secao-titulo"><div><span class="eyebrow">Continue explorando</span><h2>Trabalhos relacionados</h2></div></div><div class="cards-grid"><% relacionados.forEach(item => { %><%- include('partials/tcc-card',{item}) %><% }) %></div></div></section><% } %><%- include('partials/footer') %>

<%- include('partials/header') %><section class="page-hero trilha-hero"><div class="container narrow"><span class="eyebrow">Trilha de aprendizagem</span><h1>Seu TCC, passo a passo</h1><p>Conteúdo prático da escolha do tema até a apresentação final.</p><div class="progresso"><div><span>Seu progresso</span><strong><%= concluidos.length %> de <%= modulos.length %> módulos</strong></div><div class="barra"><span style="width:<%= modulos.length?concluidos.length/modulos.length*100:0 %>%"></span></div></div></div></section><section class="secao container narrow"><div class="trilha"><% modulos.forEach(item=>{ %><a class="modulo <%= concluidos.includes(item.id)?'concluido':'' %>" href="/aprender/<%= item.id %>"><span class="numero"><%= String(item.ordem).padStart(2,'0') %></span><div><small>Módulo <%= item.ordem %></small><h2><%= item.titulo %></h2><p><%= item.explicacao.slice(0,140) %>...</p></div><i class="fa-solid fa-<%= concluidos.includes(item.id)?'check':'chevron-right' %>"></i></a><% }) %></div><% if(!modulos.length){ %><div class="vazio"><h2>A trilha está sendo preparada</h2></div><% } %></section><%- include('partials/footer') %>
